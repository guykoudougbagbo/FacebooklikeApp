# Backend address the app talks to, without a trailing slash. On a phone, "localhost" is the phone itself:
# during development use your computer's address on the Wi-Fi (for example http://192.168.1.20:8000).
API_URL=
# Public website address used in shared links (the /p/<id>/ preview pages), without a trailing slash.
SITE_URL=
# Permanent store ID (for example com.example.genz). Can never change after the first store release.
# Only needed for builds (EAS Build), not for trying the app in Expo Go.
APP_BUNDLE_ID=
# Expo project ID, shown by "npx eas-cli@latest init" once the Expo account exists. Needed for builds and for
# notifications; without it the app works but can't turn notifications on.
EAS_PROJECT_ID=
