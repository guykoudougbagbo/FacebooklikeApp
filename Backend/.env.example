# Copy to .env for local development. Every value is required; the server will not start without it.
DJANGO_SECRET_KEY=
# true or false. Must be false anywhere real users can reach.
DJANGO_DEBUG=
# Comma-separated host names the server answers to.
DJANGO_ALLOWED_HOSTS=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
# Redis connection, for example redis://localhost:6379/0
REDIS_URL=
# Name shown in the authenticator app next to the account.
APP_NAME=
# How long a login stays valid, in seconds.
SESSION_COOKIE_AGE_SECONDS=
# Time allowed between the password step and the code step, in seconds.
LOGIN_PENDING_TTL_SECONDS=
# Phone app logins: seconds without use before they end (the website's login lasts 1209600), how often the last use
# is saved (seconds), how often the clean-up job runs (seconds), and whether it deletes (false = only logs the list).
APP_LOGIN_IDLE_SECONDS=
APP_LOGIN_TOUCH_SECONDS=
APP_LOGIN_PRUNE_INTERVAL_SECONDS=
APP_LOGIN_PRUNE_APPLY=
# How long an admin invite link works, in hours.
ADMIN_INVITE_TTL_HOURS=
# How many one-time backup codes each admin gets.
RECOVERY_CODE_COUNT=
# Items per page in API lists.
API_PAGE_SIZE=
# Request limits, written as count/period with period s, m, h or d (for example 10/m).
THROTTLE_LOGIN_IP_RATE=
THROTTLE_LOGIN_ACCOUNT_RATE=
THROTTLE_SECOND_STEP_RATE=
THROTTLE_INVITE_RATE=
# Folder for public web photos (relative to Backend/ or absolute), and the URL they are served under.
MEDIA_ROOT=
MEDIA_URL=
# Private folder for uploads as received; never served to the web.
PHOTO_ORIGINALS_ROOT=
# Post limits.
POST_MAX_TEXT_LENGTH=
POST_MAX_MEDIA=
# Largest accepted photo file, in bytes, and largest picture, in pixels (width x height).
PHOTO_MAX_UPLOAD_BYTES=
PHOTO_MAX_PIXELS=
# Longest side of the feed and full-screen versions, in pixels, and their WebP quality (1-100).
PHOTO_FEED_MAX_PX=
PHOTO_FULL_MAX_PX=
PHOTO_WEBP_QUALITY=
# Largest accepted video file (bytes) and length (seconds); longest side of the converted video (pixels).
VIDEO_MAX_UPLOAD_BYTES=
VIDEO_MAX_SECONDS=
VIDEO_MAX_PX=
# H.264 quality (lower = better, larger; 18-28 is sensible) and sound bitrate, for example 128k.
VIDEO_CRF=
VIDEO_AUDIO_BITRATE=
# Longest time one video conversion may take, in seconds.
VIDEO_PROCESSING_TIMEOUT_SECONDS=
# Largest accepted music file, in bytes.
MUSIC_MAX_UPLOAD_BYTES=
# Full paths to the ffmpeg and ffprobe programs.
FFMPEG_BINARY=
FFPROBE_BINARY=
# Public address of the site, for example https://genz.example (no trailing slash).
SITE_URL=
# How long a visitor's anonymous device cookie lasts, in seconds.
DEVICE_COOKIE_AGE_SECONDS=
# Longest comment and commenter name, in characters.
COMMENT_MAX_LENGTH=
COMMENT_NAME_MAX_LENGTH=
# Visitor limits, as count/period (s, m, h or d).
THROTTLE_COMMENT_DEVICE_RATE=
THROTTLE_COMMENT_IP_RATE=
THROTTLE_REACTION_RATE=
THROTTLE_SHARE_RATE=
THROTTLE_FOLLOW_RATE=
# Web Push keys (base64url; generate once, keep the private one secret) and a contact, mailto: or https:.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
# How long push services keep an undelivered notification, the request timeout (seconds), followers per batch.
PUSH_TTL_SECONDS=
PUSH_TIMEOUT_SECONDS=
PUSH_BATCH_SIZE=
# Comma-separated push service hosts subscriptions may use; each also allows its subdomains.
PUSH_ALLOWED_HOSTS=
# false = only log subscriptions that push services report as gone. Switch to true after reading the log.
PUSH_PRUNE_APPLY=
# Phone app: requests for a new device key per address (count/period), Expo's push endpoint
# (https://exp.host/--/api/v2/push/send), notifications per request (at most 100), retries when Expo is busy
# and the first wait in seconds (doubled each time), Expo's receipts endpoint
# (https://exp.host/--/api/v2/push/getReceipts) and how long to wait before reading receipts (Expo advises 900).
THROTTLE_APP_DEVICE_RATE=
EXPO_PUSH_URL=
EXPO_PUSH_BATCH_SIZE=
EXPO_PUSH_MAX_RETRIES=
EXPO_RETRY_BASE_SECONDS=
EXPO_RECEIPTS_URL=
EXPO_RECEIPT_DELAY_SECONDS=
# Redis for live connections (instant messages), for example redis://localhost:6379/2
CHANNEL_REDIS_URL=
# Longest private message (characters), largest group (people), and sending limit per admin (count/period).
MESSAGE_MAX_LENGTH=
GROUP_MAX_MEMBERS=
THROTTLE_MESSAGE_RATE=
# Background worker queue (Redis), for example redis://localhost:6379/1
CELERY_BROKER_URL=
# Repair job: how often it runs, when a photo counts as stuck, retries before giving up, rows per run.
POST_REPAIR_INTERVAL_SECONDS=
POST_PROCESSING_TIMEOUT_SECONDS=
POST_PROCESSING_MAX_ATTEMPTS=
POST_REPAIR_BATCH_SIZE=
# false = the repair job only logs what it would do. Switch to true after reading its log.
POST_REPAIR_APPLY=
