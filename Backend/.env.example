# Copy to .env for local development. Every value is required; the server will not start without it.
DJANGO_SECRET_KEY=
# true or false. Must be false anywhere real users can reach.
DJANGO_DEBUG=
# Comma-separated host names the server answers to.
DJANGO_ALLOWED_HOSTS=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
